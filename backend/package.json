{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:seed": "tsx src/database/seed.ts",
    "db:init": "tsx src/database/init.ts",
    "db:test": "tsx src/database/testPersistence.ts",
    "llm:test": "tsx src/ai/openrouter.test.ts",
    "mcp:test": "tsx src/mcp/mcpOrchestration.test.ts",
    "api:test": "vitest run src/api/api.test.ts src/ai/openrouter.speech.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.23.0",
    "better-sqlite3": "^13.2.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.5",
    "openai": "^6.9.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1"
  }
}
